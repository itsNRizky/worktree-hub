{
  "name": "worktree-hub",
  "displayName": "Worktree Hub",
  "description": "Projects, git worktrees and Claude Code agents in one VS Code window.",
  "version": "0.1.0",
  "publisher": "nrizky",
  "private": true,
  "engines": {
    "vscode": "^1.140.0"
  },
  "categories": [
    "Other"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "worktreeHub",
          "title": "Worktree Hub",
          "icon": "resources/hub.svg"
        }
      ]
    },
    "views": {
      "worktreeHub": [
        {
          "id": "worktreeHub.tree",
          "name": "Worktrees"
        }
      ]
    },
    "commands": [
      { "command": "worktreeHub.spike.setFolder", "title": "Set Folder", "category": "Worktree Hub Spike" },
      { "command": "worktreeHub.spike.terminal", "title": "Open Terminal", "category": "Worktree Hub Spike" },
      { "command": "worktreeHub.spike.show", "title": "Show Terminal", "category": "Worktree Hub Spike" },
      { "command": "worktreeHub.spike.terminals", "title": "List Terminals", "category": "Worktree Hub Spike" },
      { "command": "worktreeHub.refresh", "title": "Refresh", "category": "Worktree Hub", "icon": "$(refresh)" }
    ],
    "menus": {
      "view/title": [
        { "command": "worktreeHub.refresh", "when": "view == worktreeHub.tree", "group": "navigation@2" }
      ]
    },
    "viewsWelcome": [
      {
        "view": "worktreeHub.tree",
        "contents": "Worktree Hub works in its own workspace, so it can switch folders without reloading the window.\n[Set Up Workspace](command:worktreeHub.setupWorkspace)",
        "when": "!worktreeHub.isHub"
      },
      {
        "view": "worktreeHub.tree",
        "contents": "No projects yet.\n[Add Project](command:worktreeHub.addProject)",
        "when": "worktreeHub.isHub && worktreeHub.noProjects"
      }
    ],
    "configuration": {
      "title": "Worktree Hub",
      "properties": {
        "worktreeHub.projects": {
          "type": "array",
          "default": [],
          "markdownDescription": "Git repositories shown in Worktree Hub. Use **Add Project** to add one, then edit `copyFiles` and `defaultBaseBranch` here.",
          "items": {
            "type": "object",
            "required": ["path"],
            "properties": {
              "path": { "type": "string", "description": "Path of the main checkout. `~` is allowed." },
              "defaultBaseBranch": { "type": "string", "description": "Branch pre-selected when creating a worktree, e.g. staging." },
              "copyFiles": {
                "type": "array",
                "items": { "type": "string" },
                "description": "Files copied from the main checkout into every new worktree, e.g. .env. Existing files are never overwritten."
              }
            }
          }
        }
      }
    }
  },
  "scripts": {
    "build": "node esbuild.mjs",
    "watch": "node esbuild.mjs --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "package": "npm run typecheck && npm test && node esbuild.mjs --production && vsce package --no-dependencies --allow-missing-repository --skip-license"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "@types/vscode": "1.140.0",
    "@vscode/vsce": "4.0.0",
    "esbuild": "0.28.2",
    "typescript": "7.0.2",
    "vite": "8.3.4",
    "vitest": "5.0.3"
  }
}
