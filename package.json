{
  "name": "worktree-hub",
  "displayName": "Worktree Hub",
  "description": "Projects, git worktrees and Claude Code agents in one VS Code window.",
  "version": "0.1.0",
  "publisher": "nrizky",
  "private": true,
  "engines": {
    "vscode": "^1.140.0"
  },
  "categories": [
    "Other"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "worktreeHub",
          "title": "Worktree Hub",
          "icon": "resources/hub.svg"
        }
      ]
    },
    "views": {
      "worktreeHub": [
        {
          "id": "worktreeHub.tree",
          "name": "Worktrees"
        }
      ]
    },
    "commands": [
      { "command": "worktreeHub.spike.setFolder", "title": "Set Folder", "category": "Worktree Hub Spike" },
      { "command": "worktreeHub.spike.terminal", "title": "Open Terminal", "category": "Worktree Hub Spike" },
      { "command": "worktreeHub.spike.show", "title": "Show Terminal", "category": "Worktree Hub Spike" },
      { "command": "worktreeHub.spike.terminals", "title": "List Terminals", "category": "Worktree Hub Spike" },
      { "command": "worktreeHub.refresh", "title": "Refresh", "category": "Worktree Hub", "icon": "$(refresh)" },
      { "command": "worktreeHub.setupWorkspace", "title": "Set Up Workspace", "category": "Worktree Hub" },
      { "command": "worktreeHub.switch", "title": "Switch to Worktree", "category": "Worktree Hub" },
      { "command": "worktreeHub.focusTerminal", "title": "Show Terminal", "category": "Worktree Hub" },
      { "command": "worktreeHub.newAgent", "title": "New Agent", "category": "Worktree Hub", "icon": "$(add)" },
      { "command": "worktreeHub.newTerminal", "title": "New Terminal", "category": "Worktree Hub", "icon": "$(terminal)" },
      { "command": "worktreeHub.closeTerminal", "title": "Close", "category": "Worktree Hub", "icon": "$(close)" },
      { "command": "worktreeHub.revealInFinder", "title": "Reveal in Finder", "category": "Worktree Hub" },
      { "command": "worktreeHub.addProject", "title": "Add Project", "category": "Worktree Hub" },
      { "command": "worktreeHub.removeProject", "title": "Remove Project", "category": "Worktree Hub" },
      { "command": "worktreeHub.createWorktree", "title": "New Worktree", "category": "Worktree Hub", "icon": "$(add)" },
      { "command": "worktreeHub.link", "title": "Link to Another Repo…", "category": "Worktree Hub", "icon": "$(link)" },
      { "command": "worktreeHub.unlink", "title": "Unlink", "category": "Worktree Hub" },
      { "command": "worktreeHub.removeWorktree", "title": "Remove Worktree…", "category": "Worktree Hub" },
      { "command": "worktreeHub.quickSwitch", "title": "Switch to Worktree…", "category": "Worktree Hub" }
    ],
    "menus": {
      "commandPalette": [
        { "command": "worktreeHub.switch", "when": "false" },
        { "command": "worktreeHub.focusTerminal", "when": "false" },
        { "command": "worktreeHub.newAgent", "when": "false" },
        { "command": "worktreeHub.newTerminal", "when": "false" },
        { "command": "worktreeHub.closeTerminal", "when": "false" },
        { "command": "worktreeHub.revealInFinder", "when": "false" },
        { "command": "worktreeHub.removeProject", "when": "false" },
        { "command": "worktreeHub.link", "when": "false" },
        { "command": "worktreeHub.unlink", "when": "false" },
        { "command": "worktreeHub.removeWorktree", "when": "false" }
      ],
      "view/title": [
        { "command": "worktreeHub.createWorktree", "when": "view == worktreeHub.tree", "group": "navigation@1" },
        { "command": "worktreeHub.refresh", "when": "view == worktreeHub.tree", "group": "navigation@2" },
        { "command": "worktreeHub.addProject", "when": "view == worktreeHub.tree", "group": "9_setup@1" },
        { "command": "worktreeHub.setupWorkspace", "when": "view == worktreeHub.tree", "group": "9_setup@2" }
      ],
      "view/item/context": [
        { "command": "worktreeHub.createWorktree", "when": "view == worktreeHub.tree && viewItem == project", "group": "inline@1" },
        { "command": "worktreeHub.createWorktree", "when": "view == worktreeHub.tree && viewItem == project", "group": "1_create@1" },
        { "command": "worktreeHub.removeProject", "when": "view == worktreeHub.tree && viewItem == project", "group": "9_remove@1" },
        { "command": "worktreeHub.newAgent", "when": "view == worktreeHub.tree && viewItem =~ /^worktree:(primary|plain|linked)$/", "group": "inline@1" },
        { "command": "worktreeHub.newAgent", "when": "view == worktreeHub.tree && viewItem =~ /^worktree:(primary|plain|linked)$/", "group": "1_terminals@1" },
        { "command": "worktreeHub.newTerminal", "when": "view == worktreeHub.tree && viewItem =~ /^worktree:(primary|plain|linked)$/", "group": "1_terminals@2" },
        { "command": "worktreeHub.link", "when": "view == worktreeHub.tree && viewItem =~ /^worktree:(plain|linked)$/", "group": "inline@2" },
        { "command": "worktreeHub.link", "when": "view == worktreeHub.tree && viewItem =~ /^worktree:(plain|linked)$/", "group": "2_link@1" },
        { "command": "worktreeHub.unlink", "when": "view == worktreeHub.tree && viewItem == worktree:linked", "group": "2_link@2" },
        { "command": "worktreeHub.revealInFinder", "when": "view == worktreeHub.tree && viewItem =~ /^worktree:(primary|plain|linked)$/", "group": "8_misc@1" },
        { "command": "worktreeHub.removeWorktree", "when": "view == worktreeHub.tree && viewItem =~ /^worktree:(plain|linked|missing)$/", "group": "9_remove@1" },
        { "command": "worktreeHub.closeTerminal", "when": "view == worktreeHub.tree && viewItem =~ /^(agent|shell)$/", "group": "inline@1" },
        { "command": "worktreeHub.closeTerminal", "when": "view == worktreeHub.tree && viewItem =~ /^(agent|shell)$/", "group": "1_terminal@1" }
      ]
    },
    "viewsWelcome": [
      {
        "view": "worktreeHub.tree",
        "contents": "Worktree Hub works in its own workspace, so it can switch folders without reloading the window.\n[Set Up Workspace](command:worktreeHub.setupWorkspace)",
        "when": "!worktreeHub.isHub"
      },
      {
        "view": "worktreeHub.tree",
        "contents": "No projects yet.\n[Add Project](command:worktreeHub.addProject)",
        "when": "worktreeHub.isHub && worktreeHub.noProjects"
      }
    ],
    "configuration": {
      "title": "Worktree Hub",
      "properties": {
        "worktreeHub.projects": {
          "type": "array",
          "default": [],
          "markdownDescription": "Git repositories shown in Worktree Hub. Use **Add Project** to add one, then edit `copyFiles` and `defaultBaseBranch` here.",
          "items": {
            "type": "object",
            "required": ["path"],
            "properties": {
              "path": { "type": "string", "description": "Path of the main checkout. `~` is allowed." },
              "defaultBaseBranch": { "type": "string", "description": "Branch pre-selected when creating a worktree, e.g. staging." },
              "copyFiles": {
                "type": "array",
                "items": { "type": "string" },
                "description": "Files copied from the main checkout into every new worktree, e.g. .env. Existing files are never overwritten."
              }
            }
          }
        }
      }
    }
  },
  "scripts": {
    "build": "node esbuild.mjs",
    "watch": "node esbuild.mjs --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "package": "npm run typecheck && npm test && node esbuild.mjs --production && vsce package --no-dependencies --allow-missing-repository --skip-license"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "@types/vscode": "1.140.0",
    "@vscode/vsce": "4.0.0",
    "esbuild": "0.28.2",
    "typescript": "7.0.2",
    "vite": "8.3.4",
    "vitest": "5.0.3"
  }
}
